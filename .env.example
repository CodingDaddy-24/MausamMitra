# Backend configuration (copy to backend/.env; keep the database URL server-side)
# Supabase shared transaction pooler (port 6543) is recommended for Vercel.
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROVIDER_TIMEOUT_SECONDS=12
CACHE_TTL_SECONDS=600
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Frontend public API endpoint (never put server secrets in VITE_ variables).
VITE_BACKEND_URL=http://localhost:8000
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
